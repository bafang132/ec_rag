# ===================== 服务基础配置 =====================
APP_ENV=dev
APP_HOST=0.0.0.0
IMPORT_APP_PORT=8000
QUERY_APP_PORT=8001
IMPORT_APP_NAME=跨境电商知识库导入服务
QUERY_APP_NAME=跨境电商RAG智能问答服务
CORS_ORIGINS=*

# ===================== 多租户与 API Key 鉴权（可选，默认关闭） =====================
# 关闭时（默认）完全透明，行为与单租户一致；开启后需携带 API Key 并隔离租户。
AUTH_ENABLED=false
# API Keys：多个用逗号分隔；"key:tenant" 形式可绑定租户，纯 "key" 绑定默认租户。
# 例：API_KEYS=sk_prod:tenantA,sk_test:tenantB,sk_default
API_KEYS=
DEFAULT_TENANT=default

# ===================== LLM（OpenAI 兼容协议，必填） =====================
# 支持阿里百炼 DashScope / 智谱 / DeepSeek / OpenAI 等任意兼容接口
OPENAI_API_KEY=你的API密钥
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-flash
LLM_DEFAULT_TEMPERATURE=0.1
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
# 视觉模型（文档图片摘要，可选）
VL_MODEL=qwen3-vl-flash

# ===================== Embedding 提供方 =====================
# auto   : 有 BGE_M3_PATH/FlagEmbedding 用本地 BGE-M3，否则用智谱 API
# bge    : 强制本地 BGE-M3（dense+sparse 混合向量）
# zhipu  : 智谱 embedding-2 API（仅 dense 向量）
# hash   : 开发测试用确定性哈希向量（离线联调用，生产禁用）
EMBEDDING_PROVIDER=auto
EMBEDDING_DIM=1024
# 本地 BGE-M3 模型路径（可选，缺省自动下载 BAAI/bge-m3）
BGE_M3_PATH=
BGE_DEVICE=cpu
BGE_FP16=0
# 智谱 Embedding API（EMBEDDING_PROVIDER=zhipu 或 auto 降级时使用）
ZHIPU_API_KEY=
ZHIPU_EMBEDDING_MODEL=embedding-2

# ===================== Reranker =====================
# auto : 有 FlagReranker 用 bge-reranker-large，否则 LLM 兜底重排
# bge  : 强制本地 bge-reranker-large
# llm  : 强制 LLM 兜底重排
RERANKER_PROVIDER=auto
BGE_RERANKER_LARGE=BAAI/bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0

# ===================== 向量库 =====================
# auto    : 配置了 MILVUS_URL 用 Milvus，否则本地向量库
# milvus  : 强制 Milvus
# local   : 强制本地向量库（data/vector_store 持久化）
VECTORSTORE_PROVIDER=auto
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=ec_kb_chunks
ITEM_NAME_COLLECTION=ec_kb_item_names
MILVUS_DB=default
# 本地向量库持久化目录
LOCAL_VECTOR_DIR=data/vector_store/ec_local_db
# 检索参数
RETRIEVAL_DEFAULT_LIMIT=15
RERANK_CACHE_MAX=500
RERANK_CACHE_TTL=300
# 标量硬过滤开关（默认关闭：LLM 抽取值与索引标签易不匹配，硬过滤会致召回崩溃）
RETRIEVAL_USE_SCALAR_FILTER=false

# ===================== MongoDB（可选，会话/历史） =====================
# 不配置则自动使用本地 JSON 存储（data/history.json）
MONGO_URL=
MONGO_DB_NAME=ec_rag

# ===================== MinIO（可选，文档图片） =====================
# 不配置则图片落本地并通过 /api/files 访问
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=ec-rag-images
MINIO_SECURE=false

# ===================== MinerU（可选，PDF 云端解析） =====================
# 不配置则 PDF 走本地 pypdf 文本提取
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net/api/v4

# ===================== 联网搜索（可选） =====================
WEB_SEARCH_ENABLED=false
MCP_DASHSCOPE_BASE_URL=

# ===================== 语音（可选） =====================
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=nova

# ===================== 日志 =====================
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days
